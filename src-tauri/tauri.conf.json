{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Vortex Downloader",
  "version": "0.2.0",
  "identifier": "vortex.downloader",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8443",
    "beforeDevCommand": "bun run react:dev",
    "beforeBuildCommand": "bun run react:build"
  },
  "app": {
    "windows": [
      {
        "title": "Vortex",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:vortex.db"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "vortex"
        ]
      }
    }
  }
}
